# Auth Service Configuration
# Copy this file to .env and update with your actual values

# Server
PORT=3001
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://studes_user:studes_password@localhost:5432/studes_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-recommended
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-optional
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Tenant Configuration
TENANT_BASE_DOMAIN=localtest.me
TENANT_HEADER_NAME=x-tenant-id
TENANT_HEADER_SLUG_NAME=x-tenant-slug
TENANT_HEADER_PRECEDENCE=header_then_subdomain

# CORS
CORS_ORIGIN=*

# Session/Cookie
SESSION_COOKIE_NAME=studes_session
SESSION_COOKIE_SECRET=your-super-secret-cookie-key-min-32-chars
