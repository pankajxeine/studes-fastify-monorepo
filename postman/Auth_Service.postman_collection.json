{
    "info": {
        "_postman_id": "auth-service-collection",
        "name": "Auth Service API",
        "description": "Collection for testing Auth Service endpoints",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Login",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "x-tenant-id",
                        "value": "tenant-001",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password\"\n}"
                },
                "url": {
                    "raw": "http://localhost:3001/auth/login",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "3001",
                    "path": [
                        "auth",
                        "login"
                    ]
                },
                "description": "Login with username and password. Requires x-tenant-id header."
            },
            "response": []
        },
        {
            "name": "Login with Email",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "x-tenant-id",
                        "value": "tenant-001",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
                },
                "url": {
                    "raw": "http://localhost:3001/auth/login",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "3001",
                    "path": [
                        "auth",
                        "login"
                    ]
                },
                "description": "Login with email and password. Requires x-tenant-id header."
            },
            "response": []
        },
        {
            "name": "Refresh Token",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
                },
                "url": {
                    "raw": "http://localhost:3001/auth/refresh",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "3001",
                    "path": [
                        "auth",
                        "refresh"
                    ]
                },
                "description": "Refresh the access token using the refresh token from login"
            },
            "response": []
        },
        {
            "name": "Logout",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "http://localhost:3001/auth/logout",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "3001",
                    "path": [
                        "auth",
                        "logout"
                    ]
                },
                "description": "Logout the current user"
            },
            "response": []
        }
    ],
    "variable": [
        {
            "key": "accessToken",
            "value": "your-access-token-here",
            "type": "string"
        },
        {
            "key": "refreshToken",
            "value": "your-refresh-token-here",
            "type": "string"
        },
        {
            "key": "baseUrl",
            "value": "http://localhost:3001",
            "type": "string"
        }
    ]
}